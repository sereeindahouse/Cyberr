# App
PORT=3000
NODE_ENV=development
JWT_SECRET=change-me-to-a-long-random-secret

# OAuth / auth
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# SQL / Drizzle
DATABASE_URL=

# MongoDB for reports and personal writeups
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/your-db-name?retryWrites=true&w=majority
MONGODB_DB=operator-dossier

# Built-in Forge / external services
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional front-end analytics placeholders
VITE_APP_ID=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
