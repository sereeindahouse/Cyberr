# App
PORT=3000
NODE_ENV=development

# Session signing secret. MUST be a long random string (32+ chars), e.g.
#   openssl rand -hex 32
# The placeholder below is public — if deployed as-is, anyone can forge
# session tokens for any user (including the owner).
JWT_SECRET=change-me-to-a-long-random-secret

# OAuth / auth
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# OAuth portal used by the client startLogin() flow
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=

# SQL / Drizzle
DATABASE_URL=

# MongoDB for reports and personal writeups
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/your-db-name?retryWrites=true&w=majority
MONGODB_DB=operator-dossier

# Built-in Forge / external services
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Optional front-end analytics placeholders (script tag is stripped if unset)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Optional AI analyzer for the atlas / diagram modules (Round 4).
# Leave BOTH blank to keep the deterministic local analyzer (no network calls).
# MOONSHOT_API_URL=https://api.moonshot.ai/v1
# MOONSHOT_API_KEY=
# MOONSHOT_MODEL=moonshot-v1-8k

# Optional Operator Assistant chatbot (Round 6) — Groq (OpenAI-compatible).
# Leave GROQ_API_KEY blank to fall back to a plain knowledge-base digest.
# GROQ_API_URL=https://api.groq.com/openai/v1
# GROQ_API_KEY=
# GROQ_API_KEY_2=
# GROQ_MODEL=openai/gpt-oss-120b

# Optional OpenRouter background analyst. It receives the same grounded
# snippets, then its digest is passed to Gemini and Groq.
# OPENROUTER_API_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-oss-120b
